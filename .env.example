# Copier en .env à la racine OU dans backend_student/.env (les deux sont lus)

SECRET_KEY=changez-moi-une-longue-chaine-aleatoire
DEBUG=True

# --- Local : Docker (backend_student/docker-compose.yml, port 5434) ---
DATABASE_URL=postgres://studentcard_user:studentcard_dev_password@127.0.0.1:5434/studentcard_db

# --- Production Neon : coller la connection string depuis console.neon.tech ---
# Préférer "Pooled connection" sur Hugging Face. Exemple :
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- URL publique pour les QR (pas la page huggingface.co/spaces/...) ---
# En local :
PUBLIC_APP_URL=http://127.0.0.1:8000
# Sur Hugging Face Space (ex. Emera4672/studentcard-generator) :
# PUBLIC_APP_URL=https://emera4672-studentcard-generator.hf.space
# (Sur le Space, SPACE_HOST est souvent déjà défini par HF — PUBLIC_APP_URL optionnel)
# CSRF_TRUSTED_ORIGINS=https://emera4672-studentcard-generator.hf.space
